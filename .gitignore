# Secrets live in ~/.zsh.local, outside this repository, so they cannot be
# committed. These patterns are defense in depth for anything that ends up
# here by accident or by a future change.
*.local.zsh
local.zsh
local.*.zsh
.gitconfig.local
.gitconfig.*

# Never commit shell history: credentials get typed into shells and land in it
# verbatim. This is the classic public-dotfiles breach.
.zsh_history
.zsh_sessions/
.bash_history

# Generated caches. $XDG_CACHE_HOME/zsh is the real location; these catch the
# case where it falls back to somewhere inside the repo.
cache/
.zcompdump*
.zcompcache/

# Backups made by install.sh when it displaces a real file.
*.dotfiles-bak

# OS noise
.DS_Store
._.DS_Store
.localized
