# Default identity. Kept in its own file so that a machine which needs a
# different default can point an includeIf back at this one for the exceptions
# -- see the git section of the repository README.
[include]
	path = ~/.config/git/identity-personal
[alias]
	lg = log --graph --oneline --decorate
	unstage = restore --staged
	br-rm = "!f() {\n  current=$(git branch --show-current);\n  [ -z \"$current\" ] && { echo \"Not on a branch\"; return 1; };\n  target=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | cut -d/ -f2);\n  { [ -z \"$target\" ] || [ \"$target\" = \"HEAD\" ]; } && \\\n    target=$(git show-ref --verify --quiet refs/heads/main && echo main || echo master);\n  [ \"$current\" = \"$target\" ] && { echo \"Already on $target\"; return 1; };\n  git checkout \"$target\" && git branch -d \"$current\";\n}; f"
[init]
	defaultBranch = main
[fetch]
	prune = true
[core]
	autocrlf = input
	ignorecase = false
[pull]
	rebase = true
[rebase]
	autoStash = true
[checkout]
	defaultRemote = origin

# Machine-local overrides: a different default identity, host-specific settings,
# anything that should not be tracked. Git ignores this silently when absent, so
# it is a no-op on machines that have none. Must stay last -- for a single
# valued key such as user.email, the last value read wins.
[include]
	path = ~/.gitconfig.local
